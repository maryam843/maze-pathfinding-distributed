# Copy to docker/.env to override. The real .env is git-ignored.
# Default: RabbitMQ's built-in guest user, reachable only inside the compose network.
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq//
# Your user id, so files written to results/docker are owned by you (Linux: `id -u`).
HOST_UID=1000
